# REQUIRED: deployment origin. Local quick start works without editing this file.
# Production requires HTTPS, COOKIE_SECURE=true and NODE_ENV=production.
APP_PORT=4317
APP_ORIGIN=http://localhost:4317
COOKIE_SECURE=false
NODE_ENV=development

# OPTIONAL: Acta is the default identity; self-hosted installations may customize it.
ORGANIZATION_CODE=DEFAULT
ORGANIZATION_NAME=Example Organization
APP_NAME=Acta
APP_SHORT_NAME=Acta
APP_LOGO=
APP_FAVICON=
APP_ACCENT='#2b4d7c'
DEFAULT_LOCALE=es-MX
DEFAULT_TIMEZONE=UTC

# OPTIONAL: external invitation identity and lifetime. Non-nominal also requires project ADMIN opt-in.
# Identity: NONE, NAME, EMAIL or BOTH. These are recorded details, not verified identity.
INVITATION_IDENTITY=NAME
INVITATION_DEFAULT_DAYS=7
INVITATION_MAX_DAYS=30

# OPTIONAL: empty secrets are generated ONCE in private Docker volumes.
# Explicit overrides must be unique, at least 20 characters; never commit real values.
# Changing an existing credential requires rotation, not merely editing this file.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Legacy root variable names retained for existing installation secret compatibility.
# They configure the bundled storage root, not the domain provider.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OPTIONAL: default bundled VersityGW. Existing external S3 requires a private bucket.
STORAGE_PROVIDER=S3
S3_ENDPOINT=http://object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=requirements-evidence
S3_FORCE_PATH_STYLE=true
EVIDENCE_MAX_BYTES=20971520
EVIDENCE_MAX_ATTACHMENTS=10
EVIDENCE_PROJECT_BYTES=2147483648
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_DEPTH=20
IMPORT_MAX_SECTIONS=100
IMPORT_MAX_QUESTIONS=2000
IMPORT_MAX_LINKS=20000
IMPORT_MAX_REFERENCES=10000

# DEVELOPMENT ONLY. Disabled by default; never use institutional data.
DEMO_SEED=false
DEMO_PASSWORD=
# Local Node tests use private URLs configured separately; no host Node needed for Docker.
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
# DB_PORT=55439
# EVIDENCE_ROOT=./.private-evidence
