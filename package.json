{
  "name": "requirements-platform",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15 <27"
  },
  "scripts": {
    "build": "npm run build -w @requirements/contracts && npm run build -w @requirements/backend && npm run build -w @requirements/frontend",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build -w @requirements/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @requirements/contracts && npm run build -w @requirements/backend && vitest run",
    "test:integration": "npm run build -w @requirements/contracts && npm run build -w @requirements/backend && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "prisma:format": "prisma format --config app/backend/prisma.config.ts",
    "prisma:validate": "prisma validate --config app/backend/prisma.config.ts",
    "prisma:generate": "prisma generate --config app/backend/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config app/backend/prisma.config.ts",
    "db:seed": "node app/backend/dist/seed.js",
    "setup:demo": "node scripts/setup-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "dotenv": "18.0.4",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
