model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String?      @db.Uuid
  actorId        String       @db.Uuid
  actorSnapshot  Json
  action         String
  objectType     String
  objectId       String
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  before         Json?
  after          Json?
  requestId      String
  payloadHash    String?
  eventIndex     Int          @default(0)
  result         Json?
  organization   Organization @relation("AuditEvent_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User         @relation("AuditEvent_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project        Project?     @relation("AuditEvent_project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, actorId, requestId, eventIndex])
  @@index([projectId, occurredAt, id])
}

model ImportBatch {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  formatVersion String
  sourceSha256  String
  importedById  String   @db.Uuid
  importedAt    DateTime @default(now()) @db.Timestamptz(3)
  counts        Json
  requestId     String
  project       Project  @relation("ImportBatch_project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importedBy    User     @relation("ImportBatch_importedBy", fields: [importedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, sourceSha256])
  @@unique([importedById, requestId], map: "ImportBatch_actor_request")
  @@index([projectId])
}
